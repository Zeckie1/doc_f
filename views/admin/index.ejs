  <script>
    // --- Sample Data ---
    const initialOrders = [
      { id: "ORD-9281", customer: "Sarah Jenkins", email: "sarah.j@gmail.com", date: "Nov 02, 2026", amount: "$349.00", status: "Completed" },
      { id: "ORD-9280", customer: "Liam Gallagher", email: "liam.g@outlook.com", date: "Nov 02, 2026", amount: "$120.50", status: "Pending" },
      { id: "ORD-9279", customer: "Amara Okonjo", email: "amara.o@techcorp.io", date: "Nov 01, 2026", amount: "$1,240.00", status: "Completed" },
      { id: "ORD-9278", customer: "Carlos Santana", email: "carlos.s@gmail.com", date: "Nov 01, 2026", amount: "$89.99", status: "Failed" },
      { id: "ORD-9277", customer: "Emily Watson", email: "emily.w@design.net", date: "Oct 31, 2026", amount: "$450.00", status: "Completed" },
      { id: "ORD-9276", customer: "David Miller", email: "dmiller@alpha.org", date: "Oct 30, 2026", amount: "$210.00", status: "Pending" }
    ];

    let ordersData = [...initialOrders];

    // --- DOM Elements ---
    const sidebarWrapper = document.getElementById('sidebar-wrapper');
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
    const sidebarBackdrop = document.getElementById('sidebarBackdrop');
    const ordersTableBody = document.getElementById('ordersTableBody');
    const statusFilter = document.getElementById('statusFilter');
    const globalSearch = document.getElementById('globalSearch');
    const exportBtn = document.getElementById('exportBtn');
    const orderModal = new bootstrap.Modal(document.getElementById('orderModal'));
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    // --- Theme Management (Light / Dark) ---
    function getStoredTheme() {
      return localStorage.getItem('theme');
    }

    function getPreferredTheme() {
      const stored = getStoredTheme();
      if (stored) return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function setTheme(theme) {
      document.documentElement.setAttribute('data-bs-theme', theme);
      if (theme === 'dark') {
        themeIcon.classList.remove('bi-moon-stars');
        themeIcon.classList.add('bi-sun');
        themeToggleBtn.setAttribute('title', 'Switch to Light Mode');
      } else {
        themeIcon.classList.remove('bi-sun');
        themeIcon.classList.add('bi-moon-stars');
        themeToggleBtn.setAttribute('title', 'Switch to Dark Mode');
      }
      localStorage.setItem('theme', theme);
      updateChartsTheme(theme);
    }

    // Toggle theme button click listener
    themeToggleBtn.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
      setTheme(currentTheme === 'dark' ? 'light' : 'dark');
    });

    // Listen for OS theme preference changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!getStoredTheme()) {
        setTheme(getPreferredTheme());
      }
    });

    // --- Sidebar Toggle Logic ---
    function toggleSidebar() {
      if (window.innerWidth < 992) {
        document.body.classList.toggle('sidebar-mobile-show');
      } else {
        document.body.classList.toggle('sidebar-collapsed');
      }
    }

    sidebarToggle.addEventListener('click', toggleSidebar);
    if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', toggleSidebar);
    if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', toggleSidebar);

    // --- Render Orders Table ---
    function renderOrders(orders) {
      ordersTableBody.innerHTML = '';
      
      if (orders.length === 0) {
        ordersTableBody.innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">
              <i class="bi bi-inbox fs-2 d-block mb-1"></i>
              No orders found matching criteria.
            </td>
          </tr>`;
        return;
      }

      orders.forEach(order => {
        let badgeClass = 'badge-success-soft';
        if (order.status === 'Pending') badgeClass = 'badge-warning-soft';
        if (order.status === 'Failed') badgeClass = 'badge-danger-soft';

        const row = document.createElement('tr');
        row.innerHTML = `
          <td class="fw-semibold text-emphasis">${order.id}</td>
          <td>
            <div class="fw-medium text-emphasis">${order.customer}</div>
            <div class="text-muted small">${order.email}</div>
          </td>
          <td class="text-muted">${order.date}</td>
          <td class="fw-bold">${order.amount}</td>
          <td><span class="stat-badge ${badgeClass}">${order.status}</span></td>
          <td class="text-end">
            <button class="btn btn-sm btn-outline-secondary view-order-btn" data-id="${order.id}">
              <i class="bi bi-eye"></i> View
            </button>
          </td>
        `;
        ordersTableBody.appendChild(row);
      });

      // Attach view click listeners
      document.querySelectorAll('.view-order-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = e.currentTarget.getAttribute('data-id');
          openOrderDetails(id);
        });
      });
    }

    // Modal Details Viewer
    function openOrderDetails(orderId) {
      const order = ordersData.find(o => o.id === orderId);
      if (!order) return;

      document.getElementById('modalTitle').textContent = `Order Details: ${order.id}`;
      document.getElementById('modalBody').innerHTML = `
        <div class="p-3 rounded-3 mb-3" style="background-color: var(--input-bg); border: 1px solid var(--border-color);">
          <div class="row g-2">
            <div class="col-6"><span class="text-muted small">Customer:</span><p class="mb-0 fw-semibold">${order.customer}</p></div>
            <div class="col-6"><span class="text-muted small">Date:</span><p class="mb-0 fw-semibold">${order.date}</p></div>
            <div class="col-6"><span class="text-muted small">Total:</span><p class="mb-0 fw-bold" style="color: var(--primary-teal);">${order.amount}</p></div>
            <div class="col-6"><span class="text-muted small">Status:</span><p class="mb-0 fw-semibold">${order.status}</p></div>
          </div>
        </div>
        <p class="small text-muted mb-0">Delivery address confirmed and tracking updates have been dispatched to ${order.email}.</p>
      `;
      orderModal.show();
    }

    // Filter Logic
    function applyFilters() {
      const selectedStatus = statusFilter.value;
      const query = globalSearch.value.trim().toLowerCase();

      let filtered = ordersData.filter(item => {
        const matchesStatus = (selectedStatus === 'all') || (item.status === selectedStatus);
        const matchesQuery = 
          item.customer.toLowerCase().includes(query) ||
          item.id.toLowerCase().includes(query) ||
          item.email.toLowerCase().includes(query);

        return matchesStatus && matchesQuery;
      });

      renderOrders(filtered);
    }

    statusFilter.addEventListener('change', applyFilters);
    globalSearch.addEventListener('input', applyFilters);

    // Export Feedback Simulation
    exportBtn.addEventListener('click', () => {
      exportBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating...';
      exportBtn.disabled = true;

      setTimeout(() => {
        exportBtn.innerHTML = '<i class="bi bi-check2"></i> Downloaded';
        setTimeout(() => {
          exportBtn.innerHTML = '<i class="bi bi-download"></i> <span>Export Report</span>';
          exportBtn.disabled = false;
        }, 1500);
      }, 1000);
    });

    // Timeframe Buttons Simulation
    const timeframeBtns = [document.getElementById('btn7D'), document.getElementById('btn30D'), document.getElementById('btn1Y')];
    timeframeBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        timeframeBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        // Fluctuate charts
        revenueChart.data.datasets[0].data = revenueChart.data.datasets[0].data.map(val => Math.floor(val * (0.85 + Math.random() * 0.3)));
        revenueChart.update();
      });
    });

    // --- Chart.js Implementations ---
    let revenueChart, channelChart;

    function initCharts(theme) {
      const isDark = theme === 'dark';
      const gridColor = isDark ? '#334155' : '#f1f5f9';
      const tickColor = isDark ? '#94a3b8' : '#64748b';
      const primaryTeal = isDark ? '#2dd4bf' : '#0d9488';

      // 1. Revenue Chart
      const ctxRev = document.getElementById('revenueChart').getContext('2d');
      const tealGradient = ctxRev.createLinearGradient(0, 0, 0, 300);
      tealGradient.addColorStop(0, isDark ? 'rgba(45, 212, 191, 0.35)' : 'rgba(13, 148, 136, 0.35)');
      tealGradient.addColorStop(1, 'rgba(13, 148, 136, 0.0)');

      revenueChart = new Chart(ctxRev, {
        type: 'line',
        data: {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
          datasets: [
            {
              label: 'Revenue ($)',
              data: [32000, 41000, 38500, 52000, 48000, 64000, 59000, 71000, 68000, 84392, 79000, 91000],
              borderColor: primaryTeal,
              backgroundColor: tealGradient,
              borderWidth: 2.5,
              fill: true,
              tension: 0.35,
              pointBackgroundColor: isDark ? '#1e293b' : '#ffffff',
              pointBorderColor: primaryTeal,
              pointBorderWidth: 2,
              pointRadius: 4,
              pointHoverRadius: 6
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#0f172a' : '#1e293b',
              titleColor: '#f8fafc',
              bodyColor: '#f8fafc',
              borderColor: isDark ? '#334155' : '#e2e8f0',
              borderWidth: 1,
              titleFont: { size: 13, family: 'Plus Jakarta Sans' },
              bodyFont: { size: 12, family: 'Plus Jakarta Sans' },
              padding: 10,
              displayColors: false,
              callbacks: {
                label: function(context) {
                  return '$' + context.parsed.y.toLocaleString();
                }
              }
            }
          },
          scales: {
            y: {
              grid: { color: gridColor },
              ticks: {
                color: tickColor,
                callback: function(value) { return '$' + (value / 1000) + 'k'; }
              }
            },
            x: {
              grid: { display: false },
              ticks: { color: tickColor }
            }
          }
        }
      });

      // 2. Channel Traffic Doughnut Chart
      const ctxChan = document.getElementById('channelChart').getContext('2d');
      channelChart = new Chart(ctxChan, {
        type: 'doughnut',
        data: {
          labels: ['Direct Store', 'Organic Search', 'Social Media'],
          datasets: [{
            data: [52, 28, 20],
            backgroundColor: isDark ? ['#2dd4bf', '#14b8a6', '#0f766e'] : ['#0d9488', '#14b8a6', '#99f6e4'],
            hoverOffset: 6,
            borderWidth: 2,
            borderColor: isDark ? '#1e293b' : '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '72%',
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#0f172a' : '#1e293b',
              borderColor: isDark ? '#334155' : '#e2e8f0',
              borderWidth: 1,
              callbacks: {
                label: function(context) {
                  return ` ${context.label}: ${context.raw}%`;
                }
              }
            }
          }
        }
      });
    }

    // Dynamic Chart Theme Adaptation
    function updateChartsTheme(theme) {
      if (!revenueChart || !channelChart) return;

      const isDark = theme === 'dark';
      const gridColor = isDark ? '#334155' : '#f1f5f9';
      const tickColor = isDark ? '#94a3b8' : '#64748b';
      const primaryTeal = isDark ? '#2dd4bf' : '#0d9488';

      // Update Revenue Chart
      const ctxRev = document.getElementById('revenueChart').getContext('2d');
      const tealGradient = ctxRev.createLinearGradient(0, 0, 0, 300);
      tealGradient.addColorStop(0, isDark ? 'rgba(45, 212, 191, 0.35)' : 'rgba(13, 148, 136, 0.35)');
      tealGradient.addColorStop(1, 'rgba(13, 148, 136, 0.0)');

      revenueChart.data.datasets[0].borderColor = primaryTeal;
      revenueChart.data.datasets[0].backgroundColor = tealGradient;
      revenueChart.data.datasets[0].pointBackgroundColor = isDark ? '#1e293b' : '#ffffff';
      revenueChart.data.datasets[0].pointBorderColor = primaryTeal;
      revenueChart.options.scales.y.grid.color = gridColor;
      revenueChart.options.scales.y.ticks.color = tickColor;
      revenueChart.options.scales.x.ticks.color = tickColor;
      revenueChart.options.plugins.tooltip.backgroundColor = isDark ? '#0f172a' : '#1e293b';
      revenueChart.options.plugins.tooltip.borderColor = isDark ? '#334155' : '#e2e8f0';
      revenueChart.update();

      // Update Channel Chart
      channelChart.data.datasets[0].backgroundColor = isDark ? ['#2dd4bf', '#14b8a6', '#0f766e'] : ['#0d9488', '#14b8a6', '#99f6e4'];
      channelChart.data.datasets[0].borderColor = isDark ? '#1e293b' : '#ffffff';
      channelChart.options.plugins.tooltip.backgroundColor = isDark ? '#0f172a' : '#1e293b';
      channelChart.options.plugins.tooltip.borderColor = isDark ? '#334155' : '#e2e8f0';
      channelChart.update();
    }

    // Refresh Channel event simulation
    document.getElementById('refreshChannels').addEventListener('click', () => {
      channelChart.data.datasets[0].data = [
        Math.floor(40 + Math.random() * 20),
        Math.floor(20 + Math.random() * 15),
        Math.floor(10 + Math.random() * 15)
      ];
      channelChart.update();
    });

    // Initialize on window load
    window.addEventListener('load', () => {
      const initialTheme = getPreferredTheme();
      setTheme(initialTheme);
      renderOrders(ordersData);
      initCharts(initialTheme);
    });
  </script>
</body>
</html>