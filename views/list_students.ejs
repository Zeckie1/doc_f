<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <table>
        <thead>
            <tr>
                <td>Lastname</td>
                <td>Firstname</td>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            <% if(student.length> 0){
                student.forEach((get_student)=>{


                %>
                <tr>
                    <td>
                        <%= get_student.email %>
                    </td>
                    <td>
                        <%= get_student.password %>
                    </td>
                    <td><a href="/delete/<%= get_student.id %>"
                            onclick="return confirm('do you want to delete this account?')">Delete</a></td>

                    <% }); } %>
                </tr>
        </tbody>
    </table>
</body>

</html>